# Copy this file to %USERPROFILE%\.metagpt\config2.yaml and fill in secrets locally.
# Do not commit real API keys.
llm:
  api_type: "openai"
  model: "gpt-4-turbo"
  base_url: "https://api.openai.com/v1"
  api_key: "YOUR_API_KEY"

repair_llm_output: true

browser:
  engine: "playwright"
  browser_type: "chromium"
