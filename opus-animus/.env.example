# Telegram bot used by Primus push-mode morning brief.
# Create a real .env locally with these values; do not commit secrets.
PRIMUS_BOT_TOKEN=
PRIMUS_CHAT_ID=

# Optional: directory of Actio daily finance-signal exports ({date}.json), read-only.
# Defaults to opus-actio/data/_local/signals/ when unset. Keep real numbers local.
OPUS_ACTIO_SIGNALS=

# Optional: Consilium logs dir for the brief's intel step (live daily intel_reviews).
# Defaults to the in-repo opus-consilium/logs/ (gitignored). Set this when running
# the brief from a worktree/scheduler whose checkout lacks the live logs.
OPUS_CONSILIUM_LOGS=
