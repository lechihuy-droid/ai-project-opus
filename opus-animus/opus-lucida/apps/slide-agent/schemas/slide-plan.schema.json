{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucida.local/schemas/slide-plan.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["lane_id", "slides"],
  "properties": {
    "lane_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source_lesson": { "type": "string" },
    "deck_meta": { "type": "object", "additionalProperties": true },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["slide_id", "phase", "template_id", "slots"],
        "properties": {
          "slide_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "slide_number": { "type": "integer", "minimum": 1 },
          "phase": {
            "type": "string",
            "enum": ["Hook", "Try First", "Promise", "Context", "Method", "Grammar Core", "Contrast", "Exam Transfer", "Worked Example", "Practice", "Recap", "CTA"]
          },
          "template_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "source_section": { "type": "string" },
          "skeleton_link": { "type": "string" },
          "duration_sec": { "type": "integer", "minimum": 1 },
          "on_screen_text_budget": { "type": "integer", "minimum": 1 },
          "slots": { "type": "object", "additionalProperties": true },
          "speaker_notes": { "type": "string" },
          "design": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
