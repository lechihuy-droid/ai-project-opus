{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucida.local/schemas/lesson.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "lesson_title", "grammar_points", "examples", "comparisons", "practices", "cta"],
  "properties": {
    "lane_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lesson_title": { "type": "string", "minLength": 1 },
    "promise": { "type": "string" },
    "pain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": { "type": "string" },
        "local": { "type": "string" }
      }
    },
    "story_anchor": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scene": { "type": "string" },
        "character": { "type": "string" },
        "dialogue_jp": { "type": "string" },
        "dialogue_vi": { "type": "string" }
      }
    },
    "method_note": { "type": "string" },
    "grammar_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "form", "meaning_vi", "usage_vi", "examples"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "form": { "type": "string", "minLength": 1 },
          "meaning_vi": { "type": "string", "minLength": 1 },
          "usage_vi": { "type": "string", "minLength": 1 },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["jp", "vi"],
              "properties": {
                "jp": { "type": "string" },
                "vi": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "examples": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "comparisons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "clue_map": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "practices": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "recap_bullets": { "type": "array", "items": { "type": "string" } },
    "cta": { "type": "object", "additionalProperties": true }
  }
}
