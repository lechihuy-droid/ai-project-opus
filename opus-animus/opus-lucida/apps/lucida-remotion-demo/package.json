    "knowledge:validate-index": "node scripts/knowledge/validate-index.mjs",
    "knowledge:migrate": "node scripts/knowledge/migrate.mjs",
    "knowledge:build": "node scripts/knowledge/build-sqlite.mjs",
    "knowledge:query": "node scripts/knowledge/query.mjs",
    "knowledge:eval": "node scripts/knowledge/evaluate.mjs",
    "knowledge:qa": "npm run knowledge:validate && npm run knowledge:compile && npm run knowledge:build && npm run knowledge:test && npm run knowledge:eval",
