{
  "name": "lucida-remotion-demo",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.14 <25"
  },
  "dependencies": {
    "@remotion/cli": "4.0.486",
    "@remotion/google-fonts": "^4.0.486",
    "@remotion/tailwind-v4": "4.0.486",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.486",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.486",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "ajv": "^8.20.0",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "test:node-contract": "node --test tests/knowledge/node-version-contract.test.mjs",
    "test:template-knowledge": "node --test tests/knowledge/template-knowledge-validation.test.mjs",
    "knowledge:validate": "node scripts/knowledge/validate.mjs",
    "knowledge:compile": "node scripts/knowledge/compile.mjs",
    "knowledge:compile-references": "node scripts/knowledge/compile-references.mjs",
