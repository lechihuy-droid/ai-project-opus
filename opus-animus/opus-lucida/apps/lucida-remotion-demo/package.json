    "knowledge:test": "node --test tests/knowledge/*.test.mjs",
    "knowledge:preview:glitch-text": "node scripts/knowledge/render-glitch-preview.mjs",
    "flow:run": "node scripts/run-flow.mjs",
    "flow:server": "node scripts/flow-server.mjs",
    "publish:handoff": "node scripts/publish-handoff.mjs",
    "map:apply-timing": "node scripts/apply-timed-durations.mjs",
    "test:audio-e2e": "node scripts/test-audio-e2e.mjs",
    "voice:align": "node scripts/voice-align.mjs",
    "test:voice-align": "node scripts/test-voice-align.mjs",
    "dev": "remotion studio",
    "render": "node scripts/render-run.mjs",
    "voice:generate": "node scripts/voice-generate.mjs",
    "preflight": "npm run check:node && npm run knowledge:preflight && npm run validate:videomap && npm run validate:director && npm run validate:style-registry && npm run validate:registry && npx remotion compositions",
    "qa:stills": "node scripts/render-scene-stills.mjs",
    "validate:videomap": "node scripts/validate-video-map.mjs",
    "validate:brand": "node scripts/validate-brand.mjs",
    "validate:semantic": "node scripts/validate-semantic.mjs",
    "test:semantic": "node --test --test-isolation=none scripts/__tests__/*.test.mjs",
    "test:mechanism": "node --test --test-isolation=none tests/mechanism/*.test.mjs",
    "validate:director": "node scripts/validate-design-director.mjs",
    "validate:style-registry": "node scripts/validate-style-registry.mjs",
    "validate:registry": "node scripts/validate-template-registry.mjs",
    "build": "npm run knowledge:preflight && remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "npm run knowledge:preflight && eslint src && tsc",
    "validate:visual-contracts": "node scripts/validate-visual-input-contracts.mjs",
    "validate:visual-packages": "node scripts/validate-visual-packages.mjs --strict",
    "test:director": "node scripts/test-design-director.mjs",
    "test:style-runtime": "node scripts/test-style-runtime.mjs",
    "qa:styles": "node scripts/qa-all-style-packages.mjs",
    "qa:style-previews": "node scripts/render-all-style-preview-boards.mjs",
    "qa:style-reference": "node scripts/render-all-style-reference.mjs",
    "test:visual-collectors": "node scripts/test-visual-collectors.mjs",
    "collect:visual": "node scripts/collect-visual-inputs.mjs",
    "test:visual-processors": "node scripts/test-visual-processors.mjs",
    "process:visual": "node scripts/process-visual-inputs.mjs",
    "test:visual-mapper": "node scripts/test-visual-mapper.mjs",
    "map:visual": "node scripts/map-and-compile-visual-scenes.mjs",
    "validate:generated-map": "node scripts/validate-generated-video-map.mjs",
    "preview:generated": "node scripts/preview-generated-video.mjs",
    "render:generated": "node scripts/render-generated-video.mjs",
    "review:references": "node scripts/render-reference-review.mjs",
    "visual-flow": "node scripts/run-visual-flow.mjs",
    "evidence:export": "node scripts/export-visual-evidence.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
