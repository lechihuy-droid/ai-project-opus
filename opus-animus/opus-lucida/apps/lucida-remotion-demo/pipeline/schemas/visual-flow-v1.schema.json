{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-flow/v1",
  "description": "Legacy visual-flow schema. Read through the v1 compatibility adapter only.",
  "type": "object",
  "required": ["schemaVersion", "projectId", "fps", "themeId", "sources", "mapping"],
  "properties": {
    "schemaVersion": { "const": "visual-flow/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "themeId": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1 },
    "mapping": { "type": "object" }
  }
}
