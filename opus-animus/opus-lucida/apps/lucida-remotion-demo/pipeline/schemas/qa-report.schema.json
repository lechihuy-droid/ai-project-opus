{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucida-qa/v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "runId", "phase", "generatedAt", "status", "inputChecksums", "checks"],
  "properties": {
    "schemaVersion": { "const": "lucida-qa/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["pre-render", "post-render"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed"] },
    "inputChecksums": { "$ref": "#/$defs/inputChecksums" },
    "renderChecksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "evidence": {}
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "post-render" } }, "required": ["phase"] },
      "then": { "required": ["renderChecksum"] }
    }
  ],
  "$defs": {
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputChecksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedScript", "sourceVideoMap", "timedVideoMap", "renderProps", "timedScript", "audio", "normalizedInput"],
      "properties": {
        "approvedScript": { "$ref": "#/$defs/checksum" },
        "sourceVideoMap": { "$ref": "#/$defs/checksum" },
        "timedVideoMap": { "$ref": "#/$defs/checksum" },
        "renderProps": { "$ref": "#/$defs/checksum" },
        "timedScript": { "$ref": "#/$defs/checksum" },
        "audio": { "$ref": "#/$defs/checksum" },
        "normalizedInput": { "$ref": "#/$defs/checksum" },
        "contentBrief": { "$ref": "#/$defs/checksum" }
      }
    }
  }
}
