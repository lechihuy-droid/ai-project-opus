{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-flow/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "projectId", "fps", "themeId", "sources", "mapping"],
  "properties": {
    "schemaVersion": { "const": "visual-flow/v2" },
    "run": { "$ref": "./run-envelope.schema.json" },
    "projectId": { "type": "string", "minLength": 1 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "themeId": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["content_brief", "script", "repository", "command", "asciicast", "theme_reference", "web_reference", "image_reference"] },
          "family": { "$ref": "./run-envelope.schema.json#/$defs/visualFamily" }
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["allowedFamilies", "allowedPresets", "defaultPreset", "minSceneSeconds", "maxSceneSeconds", "maxItemsPerScene"],
      "properties": {
        "allowedFamilies": { "type": "array", "minItems": 1, "items": { "$ref": "./run-envelope.schema.json#/$defs/visualFamily" } },
        "allowedPresets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "defaultFamily": { "$ref": "./run-envelope.schema.json#/$defs/visualFamily" },
        "defaultPreset": { "type": "string", "minLength": 1 },
        "minSceneSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxSceneSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxItemsPerScene": { "type": "integer", "minimum": 1 }
      }
    },
    "normalization": { "type": "object" },
    "knowledge": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "run": { "properties": { "styleMode": { "const": "auto" } } } } },
      "then": {
        "properties": {
          "sources": { "items": { "not": { "required": ["family"] } } },
          "mapping": { "not": { "required": ["defaultFamily"] } }
        }
      }
    }
    ,
    {
      "if": { "properties": { "run": { "properties": { "lane": { "const": "production" } } } } },
      "then": {
        "properties": {
          "sources": {
            "contains": { "properties": { "type": { "const": "content_brief" } }, "required": ["type"] },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ]
}
