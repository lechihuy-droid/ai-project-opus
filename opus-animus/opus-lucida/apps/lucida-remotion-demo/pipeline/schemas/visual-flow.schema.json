{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-flow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "fps",
    "themeId",
    "sources",
    "mapping"
  ],
  "properties": {
    "schemaVersion": {
      "const": "visual-flow/v1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "themeId": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "script",
              "repository",
              "command",
              "asciicast",
              "theme_reference",
              "web_reference",
              "image_reference"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "artifactId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "captureInputEvents": {
            "type": "boolean"
          },
          "workingDirectory": {
            "type": "string"
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "allowedFamilies",
        "allowedPresets",
        "defaultFamily",
        "defaultPreset",
        "minSceneSeconds",
        "maxSceneSeconds",
        "maxItemsPerScene"
      ],
      "properties": {
        "allowedFamilies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "terminal",
              "dashboard",
              "editorial",
              "infographic",
              "code",
              "data_visualization",
              "product_demo",
              "cinematic_typography"
            ]
          }
        },
        "allowedPresets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defaultFamily": {
          "type": "string"
        },
        "defaultPreset": {
          "type": "string"
        },
        "minSceneSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSceneSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxItemsPerScene": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleTimeLimitSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
