{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucida.local/schemas/template-definition.schema.json",
  "title": "Lucida Template Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "logicalId",
    "version",
    "status",
    "label",
    "description",
    "familyId",
    "familyRef",
    "componentRef",
    "adapter",
    "capabilities",
    "content",
    "slots",
    "render",
    "qa",
    "provenanceRef",
    "files"
  ],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pathRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  },
  "properties": {
    "schemaVersion": { "const": "lucida-template-definition/v1" },
    "id": { "$ref": "#/definitions/slug" },
    "logicalId": { "type": "string", "pattern": "^template:[a-z0-9][a-z0-9-]*$" },
    "version": { "$ref": "#/definitions/semver" },
    "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
    "label": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 20 },
    "familyId": { "$ref": "#/definitions/slug" },
    "familyRef": { "$ref": "#/definitions/pathRef" },
    "componentRef": { "$ref": "#/definitions/pathRef" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "export"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Adapter$" },
        "path": { "$ref": "#/definitions/pathRef" },
        "export": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Adapter$" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intents", "aspectRatios", "presets", "renderable"],
      "properties": {
        "intents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
        "aspectRatios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" } },
        "presets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
        "renderable": { "const": true }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaRef", "requiredSlots", "capacity"],
      "properties": {
        "schemaRef": { "$ref": "#/definitions/pathRef" },
        "requiredSlots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headlineChars", "bodyChars"],
          "properties": {
            "headlineChars": { "type": "integer", "minimum": 1 },
            "bodyChars": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaRef"],
      "properties": { "schemaRef": { "$ref": "#/definitions/pathRef" } }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSpace", "deterministic", "safeAreaProfile", "motionPreset"],
      "properties": {
        "coordinateSpace": { "const": "scene-local" },
        "deterministic": { "const": true },
        "safeAreaProfile": { "const": "vertical-9-16" },
        "motionPreset": { "$ref": "#/definitions/slug" }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["defined", "passed", "review-required"] },
        "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenanceRef": { "$ref": "#/definitions/pathRef" },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "component", "contentSchema", "slots", "provenance", "validFixture", "invalidFixture"],
      "properties": {
        "template": { "$ref": "#/definitions/pathRef" },
        "component": { "$ref": "#/definitions/pathRef" },
        "contentSchema": { "$ref": "#/definitions/pathRef" },
        "slots": { "$ref": "#/definitions/pathRef" },
        "provenance": { "$ref": "#/definitions/pathRef" },
        "validFixture": { "$ref": "#/definitions/pathRef" },
        "invalidFixture": { "$ref": "#/definitions/pathRef" }
      }
    }
  }
}
