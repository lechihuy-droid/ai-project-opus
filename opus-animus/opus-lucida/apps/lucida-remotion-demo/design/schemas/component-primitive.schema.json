{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucida.local/schemas/component-primitive.schema.json",
  "title": "Lucida Component Primitive v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "logicalId",
    "version",
    "status",
    "label",
    "description",
    "adapterPath",
    "capabilities",
    "contentSlots",
    "render",
    "qa",
    "provenanceRef"
  ],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pathRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  },
  "properties": {
    "schemaVersion": { "const": "lucida-component-primitive/v1" },
    "id": { "$ref": "#/definitions/slug" },
    "logicalId": { "type": "string", "pattern": "^component:[a-z0-9][a-z0-9-]*$" },
    "version": { "$ref": "#/definitions/semver" },
    "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
    "label": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 20 },
    "adapterPath": { "$ref": "#/definitions/pathRef" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intents", "aspectRatios", "presets"],
      "properties": {
        "intents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
        "aspectRatios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "pattern": "^[0-9]+:[0-9]+$", "type": "string" } },
        "presets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } }
      }
    },
    "contentSlots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/slug" } },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSpace", "deterministic", "safeAreaProfile"],
      "properties": {
        "coordinateSpace": { "const": "scene-local" },
        "deterministic": { "const": true },
        "safeAreaProfile": { "const": "vertical-9-16" }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredChecks"],
      "properties": {
        "status": { "enum": ["defined", "passed", "review-required"] },
        "requiredChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenanceRef": { "$ref": "#/definitions/pathRef" }
  }
}
