{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucida.local/schemas/template-slot.schema.json",
  "title": "Lucida Template Slots v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templateId", "slots"],
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
  },
  "properties": {
    "schemaVersion": { "const": "lucida-template-slots/v1" },
    "templateId": { "$ref": "#/definitions/slug" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "sourcePath", "required", "maxChars"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "label": { "type": "string", "minLength": 2 },
          "sourcePath": { "type": "string", "pattern": "^scene\\.(headline|content\\.[a-zA-Z][a-zA-Z0-9]*)$" },
          "required": { "type": "boolean" },
          "maxChars": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
