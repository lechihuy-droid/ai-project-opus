{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucida.local/schemas/style-spec.schema.json",
  "title": "Lucida StyleSpec v1",
  "type": "object",
  "required": ["version", "brand", "video", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "video": {
      "type": "object",
      "required": ["format", "width", "height", "fps", "targetDurationSec"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "vertical_9_16"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "const": 30
        },
        "targetDurationSec": {
          "type": "number",
          "minimum": 8,
          "maximum": 180
        },
        "dominantVisualFamily": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "visualFamily",
          "templateId",
          "motionPreset",
          "durationSec",
          "density",
          "safeArea",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "intent": {
            "enum": [
              "hook",
              "problem",
              "comparison",
              "process",
              "system_architecture",
              "list",
              "use_case",
              "takeaway",
              "quote",
              "code_explanation",
              "cta"
            ]
          },
          "visualFamily": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "motionPreset": {
            "type": "string"
          },
          "backgroundEffect": {
            "type": "string"
          },
          "transitionIn": {
            "type": "string"
          },
          "transitionOut": {
            "type": "string"
          },
          "durationSec": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "density": {
            "enum": ["low", "medium", "high"]
          },
          "safeArea": {
            "enum": ["tiktok", "reels", "youtube_shorts"]
          },
          "requiredContent": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    }
  }
}
