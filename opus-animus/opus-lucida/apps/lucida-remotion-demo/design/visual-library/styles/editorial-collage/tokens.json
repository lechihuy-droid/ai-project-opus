{
  "schemaVersion": "lucida-style-tokens/v1",
  "id": "editorial-collage",
  "color": {
    "canvas": "#11100D",
    "canvasRaised": "#1C1A15",
    "paper": "#F1E7D0",
    "paperBright": "#FFF7E5",
    "ink": "#FFF7E5",
    "muted": "#D8C8A8",
    "accentRed": "#E84A3C",
    "accentGold": "#F0B341",
    "accentGreen": "#4FA86B",
    "rule": "rgba(255, 247, 229, 0.18)"
  },
  "typography": {
    "display": "Georgia serif, 58-82px, 800 weight",
    "body": "Be Vietnam Pro or Arial fallback, 18-34px, 560-820 weight",
    "metadata": "Consolas monospace fallback, 12-19px, 650 weight",
    "letterSpacing": 0
  },
  "surface": {
    "radius": 8,
    "mediaInset": 12,
    "collageShadow": "restrained black editorial drop shadow",
    "rasterDependency": false
  },
  "assetPolicy": {
    "renderableClassification": "embed_asset",
    "deterministicCrop": "xPercent, yPercent, and zoom are fixture-authored and clamped by renderer",
    "missingAssetBehavior": "deliberate placeholder with reason text"
  }
}
