{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucida.local/template-library/glitch-text/content.schema.json",
  "title": "Glitch Text Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "headline", "content"],
  "properties": {
    "intent": { "enum": ["hook", "problem", "code-explanation"] },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 220 },
        "codeTitle": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
