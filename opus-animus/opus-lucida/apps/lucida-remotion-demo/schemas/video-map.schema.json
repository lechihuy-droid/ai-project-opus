{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-map.schema.json",
  "type": "object",
  "required": ["video", "theme", "assets", "scenes"],
  "properties": {
    "mode": {
      "enum": ["slides", "continuous"],
      "default": "slides"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["component", "variant", "props"],
      "properties": {
        "component": { "const": "MechanismWindow" },
        "variant": { "enum": ["email", "chat", "doc"] },
        "props": {
          "type": "object",
          "required": ["title", "japaneseText", "vietnameseText"],
          "properties": {
            "title": { "type": "string" },
            "japaneseText": { "type": "string" },
            "vietnameseText": { "type": "string" },
            "state": { "enum": ["draft", "sent"] },
            "showCursor": { "type": "boolean" },
            "cursorBlinkFrames": { "type": "number", "exclusiveMinimum": 0 },
            "position": {
              "type": "object",
              "required": ["left", "top"],
              "properties": {
                "left": { "type": "number" },
                "top": { "type": "number" }
              },
              "additionalProperties": false
            },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "debug": {
      "type": "object",
      "properties": {
        "showTechnicalLabels": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "additionalProperties": true
    },
    "brand": {
      "type": "object",
      "required": ["id", "series"],
      "properties": {
        "id": { "const": "lucida-ai-v1" },
        "series": {
          "enum": ["lucida-now", "lucida-work", "lucida-lab", "lucida-check"]
        },
        "contractRef": { "type": "string" }
      },
      "additionalProperties": true
    },
    "video": {
      "type": "object",
      "required": [
        "title",
        "subtitle",
        "format",
        "width",
        "height",
        "fps",
        "durationSec",
        "style",
        "language"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "format": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "style": { "type": "string", "minLength": 1 },
        "language": { "enum": ["vi", "en"] },
        "sourceBlocks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "accent",
        "accentSoft",
        "background",
        "foreground",
        "muted"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "minLength": 1 },
        "accentSoft": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "foreground": { "type": "string", "minLength": 1 },
        "muted": { "type": "string", "minLength": 1 },
        "skin": { "enum": ["premium-gold", "modern-terminal"] }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src", "kind", "usage"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "src": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["image", "video", "audio"] },
          "usage": {
            "enum": ["embed_asset", "style_reference", "context_only"]
          },
          "alt": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intent",
          "durationSec",
          "headline",
          "subtitle",
          "content",
          "style",
          "motion",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "intent": {
            "enum": [
              "hook",
              "problem",
              "explain",
              "comparison",
              "process",
              "system_architecture",
              "list",
              "use_case",
              "takeaway",
              "quote",
              "code_explanation"
            ]
          },
          "templateId": { "type": "string", "minLength": 1 },
          "templateRole": {
            "enum": [
              "scene",
              "transition",
              "background_effect",
              "accent_effect",
              "subtitle",
              "cta"
            ]
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "action"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "action": { "enum": ["add", "update", "remove"] },
                "offsetSec": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "component": {
                      "enum": [
                        "ContextChip",
                        "TimerMorph",
                        "DiffHighlight",
                        "MechanismWindow"
                      ]
                    },
                    "variant": { "enum": ["email", "chat", "doc"] },
                    "title": { "type": "string" },
                    "japaneseText": { "type": "string" },
                    "vietnameseText": { "type": "string" },
                    "state": { "enum": ["draft", "sent"] },
                    "showCursor": { "type": "boolean" },
                    "cursorBlinkFrames": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "position": {
                      "type": "object",
                      "required": ["left", "top"],
                      "properties": {
                        "left": { "type": "number" },
                        "top": { "type": "number" }
                      },
                      "additionalProperties": false
                    },
                    "scale": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "additionalProperties": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "action": { "enum": ["add", "update"] }
                    }
                  },
                  "then": { "required": ["props"] }
                },
                {
                  "if": {
                    "properties": {
                      "action": { "const": "add" },
                      "props": {
                        "required": ["component"],
                        "properties": {
                          "component": { "const": "MechanismWindow" }
                        }
                      }
                    },
                    "required": ["props"]
                  },
                  "then": {
                    "properties": {
                      "props": {
                        "required": [
                          "component",
                          "variant",
                          "title",
                          "japaneseText",
                          "vietnameseText",
                          "position"
                        ]
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "durationSec": { "type": "number", "exclusiveMinimum": 0 },
          "segmentIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "startMs": { "type": "number" },
          "endMs": { "type": "number" },
          "headline": { "type": "string" },
          "subtitle": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "segments": {
                "type": "array",
                "items": { "type": "string" }
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "lines"],
                  "properties": {
                    "text": { "type": "string" },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "weight": { "enum": ["normal", "compact"] }
                  }
                }
              }
            }
          },
          "content": {
            "type": "object",
            "additionalProperties": true
          },
          "style": {
            "type": "object",
            "required": ["density", "safeArea"],
            "properties": {
              "accent": { "type": "string" },
              "density": { "enum": ["low", "medium", "high"] },
              "safeArea": { "enum": ["tiktok", "reels", "youtube_shorts"] },
              "variant": { "type": "string" }
            }
          },
          "motion": {
            "type": "array",
            "items": { "type": "string" }
          },
          "backgroundEffect": {
            "enum": [
              "matrix-rain",
              "starfield",
              "bokeh-circles",
              "noise-grain",
              "grid-pulse",
              "gradient-shift"
            ]
          },
          "transitionIn": {
            "enum": ["cross-dissolve", "slide-wipe", "whip-pan", "zoom-through"]
          },
          "transitionOut": {
            "enum": ["cross-dissolve", "slide-wipe", "whip-pan", "zoom-through"]
          },
          "subtitleMode": { "enum": ["bar", "lower-third", "none"] },
          "layout": {
            "enum": [
              "top-title",
              "center-stage",
              "oversized-type",
              "bottom-statement",
              "full-bleed-visual"
            ]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "continuous" } }
      },
      "then": {
        "required": ["environment"],
        "properties": {
          "scenes": {
            "items": {
              "required": ["transitions"],
              "properties": {
                "templateId": false,
                "templateRole": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "environment": false,
          "scenes": {
            "items": {
              "required": ["templateId", "templateRole"],
              "properties": { "transitions": false }
            }
          }
        }
      }
    }
  ]
}
