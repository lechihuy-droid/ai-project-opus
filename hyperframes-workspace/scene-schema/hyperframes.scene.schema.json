{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hyperframes.scene.schema.json",
  "title": "HyperFrames Scene Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "duration", "scenes"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "width", "height", "fps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "string" }
      }
    },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" },
      "default": []
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" },
      "default": []
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["image", "video", "audio", "font", "icon", "json", "lottie"]
        },
        "src": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "loop": { "type": "boolean" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "duration", "composition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "html"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["html", "template", "subcomposition"]
            },
            "html": { "type": "string" },
            "src": { "type": "string" }
          }
        },
        "animation": {
          "type": "array",
          "items": { "$ref": "#/$defs/animation" },
          "default": []
        },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layer" },
          "default": []
        },
        "notes": { "type": "string" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["text", "media", "shape", "code", "browser", "terminal", "chart", "timeline"]
        },
        "assetId": { "type": "string" },
        "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "enter": { "$ref": "#/$defs/motion" },
        "emphasis": { "$ref": "#/$defs/motion" }
      }
    },
    "motion": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "scale-in", "draw-x", "pulse"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["preset"],
          "properties": {
            "preset": {
              "type": "string",
              "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "scale-in", "draw-x", "pulse"]
            },
            "delay": { "type": "number", "minimum": 0 },
            "duration": { "type": "number", "exclusiveMinimum": 0 },
            "ease": { "type": "string" },
            "iterations": {
              "oneOf": [
                { "type": "number", "exclusiveMinimum": 0 },
                { "type": "string", "enum": ["infinite"] }
              ]
            }
          }
        }
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "property", "from", "to", "start", "duration"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "from": {},
        "to": {},
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "ease": { "type": "string" },
        "loop": { "type": "boolean" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "duration"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["cut", "fade", "slide", "zoom", "wipe", "match-cut"]
        },
        "duration": { "type": "number", "minimum": 0 }
      }
    }
  }
}
